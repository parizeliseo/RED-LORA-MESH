<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Ajustes" android:textSize="26sp" android:fontFamily="serif" android:textColor="@color/fg"/>

        <!-- ===== Cuentas ===== -->
        <TextView style="@style/SetSection" android:text="Mis cuentas de SIU Guaraní"/>
        <TextView style="@style/SetHelp"
            android:text="Podés tener varias: una por institución o facultad, o más de un usuario en la misma. La app las revisa a todas."/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
            <Spinner android:id="@+id/accSpinner" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"/>
            <Button android:id="@+id/accNew" style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+ Nueva"/>
        </LinearLayout>
        <TextView android:id="@+id/setStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textSize="13sp" android:alpha="0.7" android:textColor="@color/fg"/>

        <TextView style="@style/SetLabel" android:text="Institución o facultad"/>
        <AutoCompleteTextView android:id="@+id/setInst" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:completionThreshold="1" android:inputType="text" android:hint="Escribí para buscar (ej.: UTN, Comahue, IUGNA)"/>
        <TextView style="@style/SetHelp"
            android:text="Si la tuya no está en la lista, escribí abajo la dirección de tu Guaraní: la que ves en el navegador cuando entrás a autogestión."/>

        <TextView style="@style/SetLabel" android:text="Dirección de SIU Guaraní (autogestión)"/>
        <EditText android:id="@+id/setUrl" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="textUri" android:hint="https://…/autogestion/"/>

        <TextView style="@style/SetLabel" android:text="Nombre de esta cuenta"/>
        <EditText android:id="@+id/setName" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="textCapSentences" android:hint="Ej.: UTN Sistemas, Licenciatura, Diplomatura"/>

        <TextView style="@style/SetLabel" android:text="Usuario"/>
        <EditText android:id="@+id/setUser" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="text" android:autofillHints="username" android:hint="DNI, legajo o e-mail, según tu institución"/>

        <TextView style="@style/SetLabel" android:text="Contraseña"/>
        <EditText android:id="@+id/setPass" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="textPassword" android:autofillHints="password"/>
        <CheckBox android:id="@+id/setSavePass" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:checked="true" android:textColor="@color/fg"
            android:text="Guardar la contraseña en este teléfono"/>
        <TextView style="@style/SetHelp"
            android:text="Queda cifrada con el Android Keystore y solo se envía a la dirección de Guaraní de esta cuenta. Con la contraseña guardada, la app vuelve a entrar sola cuando la sesión vence. Sin guardarla, usa la sesión que abras en la pestaña Guaraní y te avisa cuando hay que volver a entrar."/>

        <Button android:id="@+id/btnSave" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:text="Guardar cuenta y revisar"/>
        <Button android:id="@+id/btnDelete" style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Borrar esta cuenta del teléfono"/>

        <!-- ===== Generales ===== -->
        <TextView style="@style/SetSection" android:text="Revisiones y avisos (todas las cuentas)"/>
        <TextView style="@style/SetLabel" android:text="Revisar Guaraní cada"/>
        <Spinner android:id="@+id/setInterval" android:layout_width="match_parent" android:layout_height="48dp"/>
        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/setAll"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
            android:text="Avisarme de cualquier cambio (no solo notas)" android:checked="true"/>
        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/setWifi"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Revisar solo con Wi-Fi" android:checked="false"/>
        <Button android:id="@+id/btnGeneral" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="Guardar"/>
        <Button android:id="@+id/btnCheck" style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Revisar todas ahora"/>
        <Button android:id="@+id/btnTest" style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Probar notificación"/>
        <Button android:id="@+id/btnBattery" style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Permitir que funcione en segundo plano"/>

        <!-- ===== Avanzado ===== -->
        <TextView style="@style/SetSection" android:text="Avanzado (cuenta elegida)"/>
        <TextView style="@style/SetLabel" android:text="Páginas de Guaraní que se vigilan (una por línea)"/>
        <TextView style="@style/SetHelp"
            android:text="Se completa sola con el menú de Guaraní en la primera revisión. Podés agregar o borrar direcciones."/>
        <EditText android:id="@+id/setPages" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="textMultiLine|textUri" android:minLines="4" android:gravity="top" android:textSize="13sp"/>
        <Button android:id="@+id/btnPages" style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Guardar páginas"/>
        <Button android:id="@+id/btnReset" style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Volver a tomar la foto inicial (sin avisar)"/>

        <TextView style="@style/SetHelp" android:layout_marginTop="20dp"
            android:text="Guaraní al día es una app libre y gratuita, hecha por un alumno. No es una aplicación oficial del SIU ni de ninguna institución. Código: github.com/parizeliseo/RED-LORA-MESH"/>
    </LinearLayout>
</ScrollView>
